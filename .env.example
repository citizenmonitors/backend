# ============================================
# Citizen Monitors Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# Database Configuration
# ============================================
# Separate clusters per environment (recommended)

# Legacy fallback (development only). In production, the app will refuse to start if only this is set.

# ============================================
# JWT Authentication
# ============================================
# IMPORTANT: Use a strong, random secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-for-security-please-change-this

# ============================================
# In-house API access (optional but recommended for production)
# ============================================
# When set, every request to paths starting with /api must include header:
#   X-Inhouse-Access-Token: <same value>
# This is NOT the user JWT. Use the user token in Authorization: Bearer <jwt> as usual.
# Comma-separated values are allowed for rotation (any match succeeds).
# Leave unset in local dev if you do not want this gate.
# INHOUSE_API_ACCESS_TOKEN=openssl-rand-hex-32-here

# ============================================
# Google Sign-In (mobile ID token verification)
# ============================================
# The backend checks the ID token audience (aud) against these client IDs.
# Android and iOS may share one OAuth client ID (common with Expo) or use separate clients.
# Optional: Web client ID if tokens are issued for a web client or server flows.
# GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
# Alternative: comma-separated list in one variable
# GOOGLE_CLIENT_IDS=id1.apps.googleusercontent.com,id2.apps.googleusercontent.com
# Legacy single client (still supported if you only set one)
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

# ============================================
# Email Configuration (ZeptoMail)
# ============================================
ZEPTO_API_KEY=your-zeptomail-api-key-here
ZEPTO_FROM_EMAIL=noreply@citizenmonitors.com
# Optional: a real monitored address improves trust with strict providers (e.g. Yahoo).
# ZEPTO_REPLY_TO_EMAIL=hello@citizenmonitors.com
# ZEPTO_REPLY_TO_NAME=Citizen Monitors

# Newsletter List-Unsubscribe URL (must match your in-app email preferences page).
# NEWSLETTER_UNSUBSCRIBE_URL=https://www.citizenmonitors.com/portal/settings/notifications

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=development
# Options: development, production

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Example: http://localhost:3000,https://citizenmonitors.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================
# API Configuration
# ============================================
API_VERSION=v1
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ============================================
# Redis Configuration (Optional)
# ============================================
# Redis is optional - app works without it
# If not provided, caching will be disabled
REDIS_URL=redis://localhost:6379

# ============================================
# Firebase Configuration (Optional)
# ============================================
# For production: set FIREBASE_SERVICE_ACCOUNT_JSON to the full JSON string of the
# service account key (from Firebase Console > Project Settings > Service accounts).
# Do not commit the key file; use env only in production.
# For local dev you can instead place firebaseServiceAccountKey.json in config/
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_STORAGE_BUCKET=gs://your-bucket-name

# ============================================
# Google Cloud Storage (Optional)
# ============================================
# If using Google Cloud Storage
# GCS_BUCKET_NAME=your-bucket-name
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json

# ============================================
# Speaker Slots (72-Hour X Space)
# ============================================
# Comma-separated emails to notify when a speaker books a slot

# X Space link included in 24h and 2h reminder emails (optional)
# SPEAKER_SPACE_LINK=https://x.com/i/spaces/...

# ============================================
# Mobile push notifications (Expo + FCM)
# ============================================
# Sends push when inbox notifications are created (uses mobileMeta.pushToken).
# - Expo tokens: ExponentPushToken[...] / ExpoPushToken[...] → Expo Push API
# - Native FCM tokens (bare React Native / Android) → Firebase Cloud Messaging (requires FIREBASE_SERVICE_ACCOUNT_JSON)
# Enabled by default in production; set PUSH_NOTIFICATIONS_ENABLED=true to force on in dev.
# PUSH_NOTIFICATIONS_ENABLED=true
# PUSH_NOTIFICATIONS_DISABLED=true
#
# EXPO_ACCESS_TOKEN — Personal access token from expo.dev (Settings → Access tokens).
# Authenticates your server with Expo's push service: higher rate limits, required for some
# projects, and ties delivery to your Expo account. Not the same as the device's pushToken.
# Generate at: https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=
# Allow POST /api/v1/mobile/notifications/test in production (default: only non-production)
# ALLOW_NOTIFICATION_TEST=true

# ============================================
# Additional Configuration
# ============================================
# Add any other environment variables here
