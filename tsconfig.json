{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 2
  },
  "include": ["**/*.ts", "**/*.js", "**/*.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tmp",
    "scripts/irev",
    "services/irev",
    "controllers/irev",
    "models/Irev",
    "utils/irev",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}

